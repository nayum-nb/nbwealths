# environment variables (example)

# Database passwords (local only)
POSTGRES_ACCOUNT_DB=accountdb
POSTGRES_ACCOUNT_USER=account
POSTGRES_ACCOUNT_PASSWORD=accountpass

POSTGRES_PORTFOLIO_DB=portfoliodb
POSTGRES_PORTFOLIO_USER=portfolio
POSTGRES_PORTFOLIO_PASSWORD=portfoliopass

POSTGRES_ADMIN_DB=admindb
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=adminpass

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Keycloak (local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nb-wealths
KEYCLOAK_FRONTEND_CLIENT_ID=angular-frontend
KEYCLOAK_ACCOUNT_CLIENT_ID=account-service
KEYCLOAK_PORTFOLIO_CLIENT_ID=portfolio-service
KEYCLOAK_ADMIN_CLIENT_ID=admin-service

# Spring profile for local run
SPRING_PROFILES_ACTIVE=local

# Optional GHCR/CI creds (only if you plan to push images)
GHCR_REGISTRY=ghcr.io
GHCR_USERNAME=<your-gh-username>
GHCR_TOKEN=<ghcr-token>
